{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "LogEntry": {
      "type": "object",
      "required": ["timestamp", "service", "level", "message"],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "service": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARN", "ERROR", "CRITICAL"]
        },
        "message": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Alert": {
      "type": "object",
      "required": ["timestamp", "severity", "source", "title", "message"],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "severity": {
          "type": "string",
          "enum": ["warning", "error", "critical"]
        },
        "source": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "context": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Metrics": {
      "type": "object",
      "required": ["timestamp", "window_seconds", "total_logs"],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "window_seconds": {
          "type": "integer"
        },
        "total_logs": {
          "type": "integer"
        },
        "by_level": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "by_service": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "error_rate": {
          "type": "number"
        }
      }
    }
  }
}
